---
import Base from '../../layouts/Base.astro';
import { audiences, serviceCategories, site } from '../../data/site';

export function getStaticPaths() {
  return audiences.map((audience) => ({
    params: { audience: audience.slug },
    props: { audience },
  }));
}

const { audience } = Astro.props;
const categories = serviceCategories.filter((category) => audience.categories.includes(category.id));
---

<Base
  title={audience.title}
  description={audience.intro}
  image={audience.image}
>
  <header class="audience-hero">
    <div class="wrap audience-hero__grid">
      <div class="audience-hero__copy">
        <p class="section-label">{audience.label}</p>
        <h1 class="audience-hero__title display" data-split="lines">{audience.title}</h1>
        <p class="audience-hero__lede" data-reveal="up">{audience.line}</p>
        <p class="page-hero__lede" data-reveal="up" data-delay="0.1" style="font-size: var(--t-body); max-width: 52ch;">
          {audience.intro}
        </p>
      </div>
      <figure class="audience-hero__media">
        <div class="audience-hero__frame" data-reveal="scale">
          <img
            src={audience.image}
            alt={audience.imageAlt}
            width="480"
            height="534"
            data-critical
          />
        </div>
      </figure>
    </div>
  </header>

  <nav class="wrap audience-nav" aria-label="Audiences">
    {audiences.map((item) => (
      <a href={`/services/${item.slug}/`} aria-current={item.slug === audience.slug ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <section class="treatment-menu">
    <div class="wrap">
      {categories.map((category) => (
        <article class="treatment-block" id={category.id}>
          <div class="treatment-block__media">
            <div class="treatment-block__frame" data-reveal="clip">
              <img src={category.image} alt={category.imageAlt} width="720" height="600" loading="lazy" />
            </div>
          </div>
          <div class="treatment-block__body">
            <span class="treatment-block__num">{category.index}</span>
            <h2 class="treatment-block__title">{category.title}</h2>
            <p class="treatment-block__kicker">{category.kicker}</p>
            <p class="treatment-block__blurb">{category.blurb}</p>
            <ul class="treatment-list">
              {category.treatments.map((treatment) => <li>{treatment}</li>)}
            </ul>
            <div class="treatment-block__actions">
              <a class="btn" href="/contact/#book">Book an appointment</a>
              <a class="text-link" href={`/services/#${category.id}`}>See the full menu</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap" style="display:flex; flex-wrap:wrap; gap:1.5rem; justify-content:space-between; align-items:end;">
      <div>
        <p class="section-label">A note on timing</p>
        <p class="lede" style="margin-top:1rem; max-width:34ch;">
          Tell us what the week looks like and we will suggest the right length. Call {site.phone}.
        </p>
      </div>
      <a class="btn btn--solid" href="/contact/#book">
        Book {audience.label.toLowerCase()}
        <svg class="btn__arrow" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 10 10 2M4 2h6v6" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
      </a>
    </div>
  </section>
</Base>

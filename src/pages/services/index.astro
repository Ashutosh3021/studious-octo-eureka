---
import Base from '../../layouts/Base.astro';
import { audiences, serviceCategories, site } from '../../data/site';
---

<Base
  title="Services"
  description="Hair, skin, spa, bridal and grooming at Lavya in Patrapada, Bhubaneswar. A full menu for women, men, bridals and kids."
>
  <header class="page-hero">
    <svg class="page-hero__strand" viewBox="0 0 600 900" preserveAspectRatio="none" aria-hidden="true">
      <path
        data-strand
        d="M 520 -40 C 380 160 560 300 430 440 C 300 580 80 520 110 700 C 132 832 300 850 470 780"
      ></path>
    </svg>
    <div class="wrap page-hero__grid">
      <div class="page-hero__copy">
        <p class="section-label">Services</p>
        <h1 class="page-hero__title display" data-split="lines">
          Everything, from the scalp down.
        </h1>
        <p class="page-hero__lede" data-reveal="up">
          Five groups of work, one team. Choose the service you came for, or start with a
          consultation and let us build the appointment around you.
        </p>
      </div>
      <div class="page-hero__side">
        <p>Open daily, 10:00 to 21:00</p>
        <p><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        <p>Prices and timing are confirmed before we begin.</p>
      </div>
    </div>
  </header>

  <section class="audiences">
    <div class="wrap">
      <div class="audiences__grid">
        {audiences.map((audience) => (
          <a class="audience-card" href={`/services/${audience.slug}/`}>
            <span class="audience-card__frame">
              <img
                src={audience.image}
                alt={audience.imageAlt}
                width="220"
                height="220"
                loading="lazy"
              />
            </span>
            <span>
              <span class="audience-card__label">{audience.label}</span>
              <span class="audience-card__title" style="display:block">{audience.title}</span>
              <span class="audience-card__line" style="display:block">{audience.line}</span>
              <svg class="audience-card__arrow" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 10 10 2M4 2h6v6" stroke="currentColor" stroke-width="1.2"></path>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="treatment-menu">
    <div class="wrap">
      {serviceCategories.map((category) => (
        <article class="treatment-block" id={category.id}>
          <div class="treatment-block__media">
            <div class="treatment-block__frame" data-reveal="clip">
              <img
                src={category.image}
                alt={category.imageAlt}
                width="720"
                height="600"
                loading="lazy"
              />
            </div>
          </div>
          <div class="treatment-block__body">
            <span class="treatment-block__num">{category.index}</span>
            <h2 class="treatment-block__title">{category.title}</h2>
            <p class="treatment-block__kicker">{category.kicker}</p>
            <p class="treatment-block__blurb">{category.blurb}</p>
            <ul class="treatment-list">
              {category.treatments.map((treatment) => <li>{treatment}</li>)}
            </ul>
            <div class="treatment-block__actions">
              <a class="btn" href="/contact/#book">Book {category.title.toLowerCase()}</a>
              <a class="text-link" href={`/services/${audiences[0].slug}/`}>For women</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap" style="display:flex; flex-wrap:wrap; gap:1.5rem; justify-content:space-between; align-items:end;">
      <p class="lede" style="max-width:30ch">Not sure where to start? Tell us the outcome you want.</p>
      <a class="btn btn--solid" href="/contact/#book">
        Ask the team
        <svg class="btn__arrow" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 10 10 2M4 2h6v6" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
      </a>
    </div>
  </section>
</Base>

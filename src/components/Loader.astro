---
import { site } from '../data/site';
---

<div id="loader" aria-hidden="true">
  <div class="loader__center">
    <span class="loader__name" data-loader-out>{site.name}</span>
    <span class="loader__sub" data-loader-out>Salon and spa, Bhubaneswar</span>
  </div>
  <div class="loader__bar" data-loader-bar></div>
  <div class="loader__foot">
    <span data-loader-out>Plot 283, Patrapada</span>
    <span class="loader__count"><span data-loader-count>000</span></span>
  </div>
</div>
